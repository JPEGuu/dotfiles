FROM archlinux:latest

RUN pacman -Syu --noconfirm && \
    pacman -S --needed --noconfirm sudo git base-devel

RUN useradd -m -G wheel testuser && \
    echo '%wheel ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

COPY --chown=testuser:testuser pkglist.txt /home/testuser/pkglist.txt

USER testuser
WORKDIR /home/testuser

# Test 1: yay bootstrap (no yay initially — mirrors install.sh logic)
RUN git clone https://aur.archlinux.org/yay.git /tmp/yay-bootstrap && \
    cd /tmp/yay-bootstrap && \
    makepkg -si --noconfirm && \
    rm -rf /tmp/yay-bootstrap && \
    yay --version && \
    echo "PASS: yay bootstrap"

