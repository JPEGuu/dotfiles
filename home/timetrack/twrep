#!/usr/bin/env python3
import argparse
from collections import defaultdict
from datetime import datetime, timezone
import json
import subprocess
import sys
import unicodedata


UTC = timezone.utc
UNCLASSIFIED = "未分類"
NO_TAG = "（タグ無し）"
NO_DESCRIPTION = "（説明無し）"
BAR_MAX = 14
PAL = [2, 1, 4, 3, 5, 6]


def parse_ts(s):
    return datetime.strptime(s, "%Y%m%dT%H%M%SZ").replace(tzinfo=UTC)


def seconds_of(iv, now):
    end = parse_ts(iv["end"]) if iv.get("end") else now
    return max(0, int((end - parse_ts(iv["start"])).total_seconds()))


def fmt_hm(seconds):
    m = round(seconds / 60)
    return f"{m // 60}:{m % 60:02d}"


def _w(s):
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)


def _dot(code, color):
    return f"\033[38;5;{code}m●\033[0m" if color else "●"


def _seg(code, n, color):
    blocks = "█" * n
    return f"\033[38;5;{code}m{blocks}\033[0m" if color else blocks


def _stacked(tag_items, ptot_sec, grand_sec, color, color_of):
    if not tag_items:
        return ""
    if ptot_sec <= 0 or grand_sec <= 0:
        base = [1] + [0] * (len(tag_items) - 1)
    else:
        nb = max(1, round(ptot_sec / grand_sec * BAR_MAX))
        raw = [(sec / ptot_sec * nb, tag) for tag, sec in tag_items]
        base = [int(x) for x, _ in raw]
        rem = nb - sum(base)
        for i in sorted(range(len(raw)), key=lambda i: raw[i][0] - base[i], reverse=True)[:rem]:
            base[i] += 1
    return "".join(_seg(color_of(t), b, color) for b, (t, _) in zip(base, tag_items) if b > 0)


def tags_of(iv):
    tags = iv.get("tags", [])
    return tags if isinstance(tags, list) else []


def classify(tags):
    project = None
    tag = None
    for t in tags:
        key, sep, val = t.partition(":")
        if not sep:
            continue
        if key == "project":
            project = val
        elif key == "tag":
            tag = val
    return project, tag


def description_of(tags):
    description = None
    for t in tags:
        key, sep, val = t.partition(":")
        if sep and key == "description":
            description = val
    return description if description else NO_DESCRIPTION


def _multiple_tag_warnings(intervals):
    warnings = []
    for iv in intervals:
        count = sum(1 for t in tags_of(iv) if t.partition(":")[0] == "tag" and ":" in t)
        if count > 1:
            warnings.append(f"interval {iv.get('id', '?')}: tag: が複数あります。最後を採用します。")
    return warnings


def _display_tag(t):
    key, sep, val = t.partition(":")
    if sep and key in {"description", "project", "tag"}:
        return val
    return t


def _raw_label(tags):
    labels = [_display_tag(t) for t in tags]
    return " / ".join(labels) if labels else NO_TAG


def _interval_start(iv):
    try:
        return parse_ts(iv["start"])
    except Exception as exc:
        raise ValueError(f"invalid timestamp for interval id {iv.get('id', '?')}: {exc}") from exc


def _interval_seconds(iv, now):
    try:
        return seconds_of(iv, now)
    except Exception as exc:
        raise ValueError(f"invalid timestamp for interval id {iv.get('id', '?')}: {exc}") from exc


def _min_start(mapping, key, start):
    mapping[key] = min(mapping.get(key, start), start)


def _project_matches(value, wanted):
    return value == wanted or value.startswith(wanted + ".")


def _filter_interval(iv, project=None, tag=None):
    iv_project, iv_tag = classify(tags_of(iv))
    if project is not None and (iv_project is None or not _project_matches(iv_project, project)):
        return False
    if tag is not None and iv_tag != tag:
        return False
    return True


def _aggregate(intervals, now, project=None, tag=None):
    project_sec = defaultdict(int)
    project_start = {}
    tag_sec = defaultdict(int)
    tag_start = {}
    detail_sec = defaultdict(int)
    detail_start = {}
    project_tags = defaultdict(set)
    tag_descriptions = defaultdict(set)
    unclassified_count = 0

    for iv in intervals:
        if not _filter_interval(iv, project=project, tag=tag):
            continue
        start = _interval_start(iv)
        seconds = _interval_seconds(iv, now)
        iv_project, iv_tag = classify(tags_of(iv))
        if iv_project is None:
            unclassified_count += 1
        p = iv_project or UNCLASSIFIED
        t = iv_tag or NO_TAG
        d = description_of(tags_of(iv))
        detail = (p, t, d)

        project_sec[p] += seconds
        _min_start(project_start, p, start)
        tag_sec[(p, t)] += seconds
        _min_start(tag_start, (p, t), start)
        detail_sec[detail] += seconds
        _min_start(detail_start, detail, start)
        project_tags[p].add(t)
        tag_descriptions[(p, t)].add(d)

    return {
        "project_sec": project_sec,
        "project_start": project_start,
        "tag_sec": tag_sec,
        "tag_start": tag_start,
        "detail_sec": detail_sec,
        "detail_start": detail_start,
        "project_tags": project_tags,
        "tag_descriptions": tag_descriptions,
        "total": sum(project_sec.values()),
        "unclassified_count": unclassified_count,
    }


def _sort_names(names, starts):
    return sorted(names, key=lambda name: (starts[name], name))


def _sorted_projects(data):
    return _sort_names(data["project_sec"].keys(), data["project_start"])


def _sorted_tags(data, project):
    tags = data["project_tags"].get(project, set())
    return sorted(tags, key=lambda t: (data["tag_start"][(project, t)], t))


def _sorted_descriptions(data, project, tag):
    descriptions = data["tag_descriptions"].get((project, tag), set())
    return sorted(descriptions, key=lambda d: (data["detail_start"][(project, tag, d)], d))


def _detail_label(tag, description):
    return f"{tag}  {description}"


def _layout_widths(data):
    label_width = 0
    time_width = 0
    for project in _sorted_projects(data):
        label_width = max(label_width, _w(project))
        time_width = max(time_width, _w(fmt_hm(data["project_sec"][project])))
        for t in _sorted_tags(data, project):
            for description in _sorted_descriptions(data, project, t):
                label_width = max(label_width, _w("● " + _detail_label(t, description)))
                time_width = max(time_width, _w(fmt_hm(data["detail_sec"][(project, t, description)])))
    return label_width, time_width


def _make_color_of(data):
    colors = {}
    next_index = 0

    def color_of(tag):
        nonlocal next_index
        if tag == NO_TAG:
            return 8
        if tag not in colors:
            colors[tag] = PAL[next_index % len(PAL)]
            next_index += 1
        return colors[tag]

    for project in _sorted_projects(data):
        for t in _sorted_tags(data, project):
            color_of(t)
    return color_of


def _line(label_plain, label_text, seconds, label_width, time_width):
    time_text = fmt_hm(seconds)
    label_pad = " " * (label_width - _w(label_plain) + 2)
    time_pad = " " * (time_width - _w(time_text))
    return f"{label_text}{label_pad}{time_pad}{time_text}"


def build_report(intervals, now, project=None, tag=None, color=False):
    data = _aggregate(intervals, now, project=project, tag=tag)
    label_width, time_width = _layout_widths(data)
    color_of = _make_color_of(data)
    lines = []
    for project in _sorted_projects(data):
        if lines:
            lines.append("")
        tags = _sorted_tags(data, project)
        tag_items = [(t, data["tag_sec"][(project, t)]) for t in tags]
        project_line = _line(
            project,
            project,
            data["project_sec"][project],
            label_width,
            time_width,
        )
        bar = _stacked(tag_items, data["project_sec"][project], data["total"], color, color_of)
        lines.append(f"{project_line}  {bar}" if bar else project_line)

        for t in tags:
            for description in _sorted_descriptions(data, project, t):
                plain_label = "● " + _detail_label(t, description)
                text_label = f"{_dot(color_of(t), color)} {_detail_label(t, description)}"
                lines.append(
                    _line(
                        plain_label,
                        text_label,
                        data["detail_sec"][(project, t, description)],
                        label_width,
                        time_width,
                    )
                )

    if lines:
        lines.append("")
    lines.append(f"合計 {fmt_hm(data['total'])}")
    if data["unclassified_count"] > 0:
        lines.append(f"未分類が {data['unclassified_count']} 件あります。tfix で修正できます。")
    return "\n".join(lines)


def build_unclassified(intervals):
    lines = []
    for iv in intervals:
        project, tag = classify(tags_of(iv))
        if project is not None and tag is not None:
            continue
        try:
            start = parse_ts(iv["start"]).astimezone()
            end = parse_ts(iv["end"]).astimezone().strftime("%H:%M") if iv.get("end") else "--:--"
        except Exception as exc:
            raise ValueError(f"invalid timestamp for interval id {iv.get('id', '?')}: {exc}") from exc
        label = _raw_label(tags_of(iv))
        lines.append(f"{iv['id']}\t{start:%Y-%m-%d} {start:%H:%M}-{end}  {label}")
    return lines


def load_intervals(range_hint):
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
        if raw.strip():
            return json.loads(raw)
    out = subprocess.run(
        ["timew", "export", range_hint],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return json.loads(out or "[]")


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("range", nargs="?", default=":day")
    parser.add_argument("--project")
    parser.add_argument("--tag")
    parser.add_argument("--color", action="store_true", default=False)
    parser.add_argument("--list-unclassified", action="store_true")
    args = parser.parse_args(argv)

    try:
        intervals = load_intervals(args.range)
        for warning in _multiple_tag_warnings(intervals):
            print(warning, file=sys.stderr)
        if args.list_unclassified:
            output = "\n".join(build_unclassified(intervals))
        else:
            output = build_report(
                intervals,
                datetime.now(UTC),
                project=args.project,
                tag=args.tag,
                color=args.color,
            )
    except subprocess.CalledProcessError as exc:
        sys.stderr.write(exc.stderr)
        return exc.returncode
    except (json.JSONDecodeError, ValueError, KeyError) as exc:
        print(exc, file=sys.stderr)
        return 1

    if output:
        print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
