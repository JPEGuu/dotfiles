FROM archlinux:latest

# 必要な最小限のパッケージをインストール
RUN pacman -Syu --noconfirm && \
    pacman -S --needed --noconfirm sudo git base-devel

# テストユーザーの作成
RUN useradd -m -G wheel testuser && \
    echo '%wheel ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# リポジトリ全体をコピー
WORKDIR /home/testuser/dotfiles
COPY --chown=testuser:testuser . .

USER testuser

# install.sh を実行
RUN ./install.sh

# 検証: シンボリックリンク
RUN [ -L "$HOME/.zshrc" ] && [ "$(readlink "$HOME/.zshrc")" = "/home/testuser/dotfiles/.zshrc" ]
RUN [ -L "$HOME/.config/nvim" ] && [ "$(readlink "$HOME/.config/nvim")" = "/home/testuser/dotfiles/.config/nvim" ]

# 検証: ツール
RUN command -v yay >/dev/null
RUN export PATH="$HOME/.local/bin:$PATH" && command -v agy >/dev/null
RUN export PATH="$HOME/.cargo/bin:$PATH" && command -v rtk >/dev/null

# 検証: 主要なパッケージが pacman/yay でインストールされているか
RUN pacman -Qi neovim tmux zsh yazi fzf ripgrep fd starship sheldon zoxide >/dev/null

# 検証: nvm / node (nvm のインストールは Docker 内で失敗することがあるため、存在確認のみ試みる)
RUN [ -s "$HOME/.config/nvm/nvm.sh" ] || echo "Warning: nvm not installed, but proceeding"

RUN echo "PASS: Integration test for install.sh succeeded"
